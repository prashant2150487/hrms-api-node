{
  "info": {
    "name": "HRMS Employee API",
    "description": "API collection for Employee Management endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe@company.com\",\n  \"personal_email\": \"john.personal@gmail.com\",\n  \"emp_code\": \"EMP001\",\n  \"phone_primary\": \"+1-555-0123\",\n  \"date_of_joining\": \"2026-05-01\",\n  \"employment_type\": \"full_time\",\n  \"role_id\": 2\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/employees",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "employees"]
        }
      },
      "response": []
    },
    {
      "name": "Get All Employees",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/employees?page=1&limit=10&search=",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "employees"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Employee by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/employees/1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "employees", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Update Employee",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Jonathan\",\n  \"last_name\": \"Doe\",\n  \"date_of_joining\": \"2026-05-01\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/employees/1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "employees", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Delete Employee",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/employees/1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "employees", "1"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ]
}
